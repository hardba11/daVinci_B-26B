<?xml version="1.0" encoding="UTF-8"?>

<PropertyList>

  <particlesystem>
    <name>cranking</name>
    <type>normal</type>
    <texture>cranking.png</texture>
    <emissive type="bool">false</emissive>
    <lighting type="bool">true</lighting>
    <condition>
      <property>sim/multiplay/generic/float[5]</property>
      <value>true</value>
    </condition>
    <attach>world</attach>
    <placer>
      <type>point</type>
    </placer>
    <shooter>
      <theta-min-deg>  60 </theta-min-deg>
      <theta-max-deg> 70 </theta-max-deg>
      <phi-min-deg>   -10 </phi-min-deg>
      <phi-max-deg>    50 </phi-max-deg>
      <speed-mps>
        <value>2.5</value>
        <spread>1</spread>
      </speed-mps>
      <rotation-speed>
        <x-min-deg-sec>0</x-min-deg-sec>
        <y-min-deg-sec>0</y-min-deg-sec>
        <z-min-deg-sec>0</z-min-deg-sec>
        <x-max-deg-sec>0</x-max-deg-sec>
        <y-max-deg-sec>0</y-max-deg-sec>
        <z-max-deg-sec>0</z-max-deg-sec>
      </rotation-speed>
    </shooter>
    <counter>
      <particles-per-sec>
        <value>20</value>
        <spread>10</spread>
      </particles-per-sec>
    </counter>
    <particle>
      <start>
        <color>
          <red><value>   0.42 </value></red>
          <green><value> 0.43 </value></green>
          <blue><value>  0.4 </value></blue>
          <alpha><value> 0.5 </value></alpha>
        </color>
        <size>
          <value>0.15</value>
        </size>
      </start>
      <end>
        <color>
          <red><value>   0.33 </value></red>
          <green><value> 0.33 </value></green>
          <blue><value>  0.33 </value></blue>
          <alpha><value> 0.03 </value></alpha>
        </color>
        <size>
          <value>1.0</value>
        </size>
      </end>
      <life-sec>
        <value>2.0</value>
      </life-sec>
      <mass-kg>  0.3 </mass-kg>
      <radius-m> 0.01 </radius-m>
    </particle>
    <program>
      <fluid>               air  </fluid>
      <gravity type="bool"> true </gravity>
      <wind typ="bool">     true </wind>
    </program>
  </particlesystem>
</PropertyList>






