<?xml version="1.0" encoding="utf-8"?>

<PropertyList>

  <particlesystem>

    <name>rain_engine0</name>
    <texture>rain.png</texture>
    <emissive type="bool">false</emissive>
    <lighting type="bool">false</lighting>
    <pass>true</pass>
    <attach>local</attach>
    <placer><type>point</type></placer>
    <align>billboard</align>
    <program>
      <fluid>air</fluid>
      <gravity type="bool">true</gravity>
      <wind typ="bool">true</wind>
    </program>

    <shooter>
      <theta-min-deg>75</theta-min-deg>
      <theta-max-deg>90</theta-max-deg>
      <phi-min-deg>-10</phi-min-deg>
      <phi-max-deg>10</phi-max-deg>
      <speed-mps>
        <property>engines/engine[0]/rpm</property>
        <factor>0.01</factor>
        <spread>0</spread>
      </speed-mps>
      <rotation-speed>
        <x-max-deg-sec>10</x-max-deg-sec>
        <x-min-deg-sec>-10</x-min-deg-sec>
        <y-max-deg-sec>10</y-max-deg-sec>
        <y-min-deg-sec>-10</y-min-deg-sec>
        <z-max-deg-sec>10</z-max-deg-sec>
        <z-min-deg-sec>-10</z-min-deg-sec>
      </rotation-speed>
    </shooter>
    <counter>
      <particles-per-sec>
        <value>20</value>
        <spread>0</spread>
      </particles-per-sec>
    </counter>
    <particle>
      <start>
        <color>
          <red><value>0.7</value></red>
          <green><value>0.7</value></green>
          <blue><value>0.7</value></blue>
          <alpha>
            <property>engines/engine[0]/rpm</property>
            <factor>0.0002</factor>
          </alpha>
        </color>
        <size>
          <value>2</value>
        </size>
      </start>
      <end>
        <color>
          <red><value>0.7</value></red>
          <green><value>0.7</value></green>
          <blue><value>0.7</value></blue>
          <alpha><value>0.02</value></alpha>
        </color>
        <size>
          <value>5</value>
        </size>
      </end>
      <life-sec>
        <value>1.5</value>
      </life-sec>
      <mass-kg>10</mass-kg>
      <radius-m>0.2</radius-m>
    </particle>

    <condition>
      <and>
        <greater-than>
          <property>/environment/rain-norm</property>
          <value>0.1</value>
        </greater-than>
        <greater-than>
          <property>engines/engine[0]/rpm</property>
          <value>700</value>
        </greater-than>
        <less-than>
          <property>position/gear-agl-m</property>
          <value>5</value>
        </less-than>
      </and>
    </condition>

  </particlesystem>

</PropertyList>
