<?xml version="1.0" encoding="UTF-8"?>

<PropertyList>

  <key><name>s</name><desc>Start engines</desc></key>
  <key><name>h</name><desc>Toggle HUD</desc></key>
  <key><name>ctrl-p/ ctrl-P</name><desc>Enable / Disable autopilot to keep current heading, altitude and speed</desc></key>
  <key><name>ctrl-a</name><desc>Toggle autopilot on Altitude</desc></key>
  <key><name>ctrl-s</name><desc>Toggle autopilot on Speed</desc></key>
  <key><name>ctrl-h</name><desc>Toggle autopilot on Heading (bug)</desc></key>
  <key><name>[ / ]</name><desc>Flaps up / down</desc></key>
  <key><name>j / k</name><desc>Speedbrakes up / down</desc></key>
  <key><name>n / N</name><desc>Propeller Coarse / Fine</desc></key>
  <key><name>m / M</name><desc>Richer / Leaner Mixture</desc></key>
  <key><name>k / j</name><desc>Extend / Retract Speedbrakes</desc></key>
  <key><name>d</name><desc>Toggle windows and entry hatch to nose wheel well</desc></key>
  <key><name>D</name><desc>Toggle bay doors</desc></key>
  <key><name>c</name><desc>Carrier launch-bar engage</desc></key>
  <key><name>C</name><desc>Catapult launch command</desc></key>
  <key><name>o</name><desc>Hook up/down</desc></key>
  <text>
START
1. check fuel
2. press "s" OR batt=ON, avionics=ON, fuel pumps=ON, magneto=BOTH, mixture=100, lights=adjust, starter=ON
3. mixture=adjust

TAKE OFF
flaps2 - 150kt : rotate 

FINALE
180Kt - flaps7 - -900fpm

LANDING
130kt - flaps10
  </text>
</PropertyList>


